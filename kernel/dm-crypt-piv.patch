@@ -3761,0 +3805,15 @@
+static int crypt_message(struct dm_target *ti, unsigned int argc, char **argv,
+			 char *result, unsigned int maxlen)
+{
+	struct crypt_config *cc = ti->private;
+	struct piv_control *p = cc->piv_control;
+	int ret;
+	if (!p)
+		return crypt_message_inner(ti, argc, argv, result, maxlen);
+	mutex_lock(&p->lock);
+	ret = (p->transaction || p->resuming || p->native) ? -EBUSY :
+		crypt_message_inner(ti, argc, argv, result, maxlen);
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
@@ -3802,0 +3861,2 @@
+	.presuspend = piv_presuspend,
