#!/bin/sh
# initramfs-tools hook for early dm-piv activation (packaging/README.md).
# Adds pivsetup, cryptsetup, dmsetup, the dm-piv module and the
# crypto modules of both supported LUKS2 profiles, plus a validated copy of
# /etc/pivtab. Key files are embedded only for entries with embed-keys.
set -e
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions

CONF=/etc/pivtab
[ -r "$CONF" ] || exit 0

fail() { echo "E: pivsetup hook: $*" >&2; exit 1; }

valid_name() {
    case "$1" in piv-*) ;; *) return 1 ;; esac
    case "${1#piv-}" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
    [ "${#1}" -le 44 ]
}

# Embedded keys need a private image: refuse unless an initramfs-tools
# configuration sets UMASK=0077 (install.sh installs conf.d/pivsetup).
private_image() {
    grep -qsx 'UMASK=0077' "${CONFDIR:-/etc/initramfs-tools}/initramfs.conf" \
        "${CONFDIR:-/etc/initramfs-tools}"/conf.d/*
}

embed() {  # embed SOURCE DESTINATION-NAME
    [ -f "$1" ] && [ -r "$1" ] || fail "key file $1 is not a readable regular file"
    private_image || fail "embed-keys needs UMASK=0077 in an initramfs-tools configuration (conf.d/pivsetup)"
    mkdir -p "${DESTDIR}/etc/pivsetup"
    chmod 0700 "${DESTDIR}/etc/pivsetup"
    (umask 077; cp "$1" "${DESTDIR}/etc/pivsetup/$2")
    chmod 0600 "${DESTDIR}/etc/pivsetup/$2"
}

entries=0
ask=no
generated=$(mktemp)
trap 'rm -f "$generated"' EXIT
while read -r name device luks hidden options extra; do
    case "$name" in ''|'#'*) continue ;; esac
    [ -z "$extra" ] && [ -n "$options" ] || fail "$CONF: expected 5 fields for $name"
    valid_name "$name" || fail "$CONF: invalid mapping name $name (piv-[A-Za-z0-9_-], at most 44 characters)"
    case "$device" in /dev/*) ;; *) fail "$CONF: $name: device must be a /dev path" ;; esac
    embed_keys=no hidden_passphrase=no cost=
    [ "$options" = - ] && options=
    old_ifs=$IFS; IFS=,
    for option in $options; do
        case "$option" in
            embed-keys) embed_keys=yes ;;
            hidden-passphrase) hidden_passphrase=yes ;;
            kdf-cost=[1-4]) cost=${option#kdf-cost=} ;;
            *) IFS=$old_ifs; fail "$CONF: $name: unknown option $option" ;;
        esac
    done
    IFS=$old_ifs
    [ -z "$cost" ] || [ "$hidden_passphrase" = yes ] || fail "$CONF: $name: kdf-cost needs hidden-passphrase"
    if [ "$hidden" = ask ] && [ "$hidden_passphrase" != yes ]; then
        fail "$CONF: $name: a hidden key file cannot be typed; use hidden-passphrase with ask"
    fi
    for value in "$luks" "$hidden"; do
        case "$value" in
            ask) ask=yes ;;
            /*) [ "$embed_keys" = yes ] || fail "$CONF: $name: key file $value would not exist at boot; use ask or embed-keys" ;;
            *) fail "$CONF: $name: key must be an absolute path or ask" ;;
        esac
    done
    if [ "$luks" != ask ]; then embed "$luks" "$name.luks"; luks=/etc/pivsetup/$name.luks; fi
    if [ "$hidden" != ask ]; then embed "$hidden" "$name.hidden"; hidden=/etc/pivsetup/$name.hidden; fi
    flags=
    [ "$hidden_passphrase" = yes ] && flags=hidden-passphrase
    [ -n "$cost" ] && flags="$flags,kdf-cost=$cost"
    flags=${flags#,}
    printf '%s %s %s %s %s\n' "$name" "$device" "$luks" "$hidden" "${flags:--}" >> "$generated"
    entries=$((entries + 1))
done < "$CONF"
[ "$entries" -gt 0 ] || exit 0

mkdir -p "${DESTDIR}/etc"
install -m 0600 "$generated" "${DESTDIR}/etc/pivtab"

pivsetup=$(command -v pivsetup || true)
[ -n "$pivsetup" ] || pivsetup=/usr/local/sbin/pivsetup
[ -x "$pivsetup" ] || fail "pivsetup is not installed (packaging/install.sh pivsetup)"
copy_exec "$pivsetup" /usr/sbin/pivsetup
copy_exec /usr/sbin/cryptsetup
copy_exec /usr/sbin/dmsetup
# Used by the local-top script (busybox, when present, provides them too).
for tool in dd wc sleep; do copy_exec "/usr/bin/$tool"; done
if [ "$ask" = yes ]; then
    [ -x /lib/cryptsetup/askpass ] || fail "ask needs /lib/cryptsetup/askpass (package cryptsetup-initramfs)"
    copy_exec /lib/cryptsetup/askpass
fi

modinfo -k "$version" dm-piv >/dev/null 2>&1 ||
    fail "no dm-piv module for kernel $version (packaging/install.sh dkms)"
manual_add_modules dm-piv
manual_add_modules dm_integrity
manual_add_modules dm_crypt
# AEGIS-128 profile; format v5 hidden records (ChaCha20, HMAC-SHA256).
# Newer kernels renamed chacha_generic/sha256_generic to chacha/sha256;
# manual_add_modules skips names the kernel does not have.
for module in aegis128 chacha_generic chacha hmac sha256_generic sha256; do
    manual_add_modules "$module"
done
# AES-XTS + HMAC-SHA256 authenc profile (generic and x86-optimized).
for module in authenc xts aes_generic sha256-ssse3 aesni_intel; do
    manual_add_modules "$module"
done
